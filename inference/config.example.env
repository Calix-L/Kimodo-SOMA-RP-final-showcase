# Copy this file outside the repository, edit the paths, then pass it to run_pipeline.sh.
PYTHON=/path/to/.venv-kimodo/bin/python
KIMODO_ROOT=/path/to/kimodo-upstream
BENCHMARK_DIR=/path/to/prepared_benchmark
RUN_DIR=/path/to/writable_experiment_directory

# Model setup. Leave CHECKPOINT empty for the original RP checkpoint.
MODEL_NAME=Kimodo-SOMA-RP-v1.1
MODEL_LABEL=rp_base
CHECKPOINT=

# Offline Kimodo/TMR assets.
CHECKPOINT_ROOT=/path/to/checkpoints
TEXT_ENCODERS_DIR=/path/to/text_encoders

# Inference/evaluation settings.
CUDA_VISIBLE_DEVICES=0
DEVICE=cuda:0
BATCH_SIZE=256
NUM_WORKERS=4
DIFFUSION_STEPS=100
EXPECTED_COUNT=
POSTPROCESS=0
PHYSICAL_BATCH_SIZE=32
MOTION_BATCH_SIZE=1
TEXT_BATCH_SIZE=32
TMR_MAX_FRAMES=300

# Optional cached text encoder. Set both or neither.
FEATURE_INDEX=
TEXT_FEATURE_DIR=

# Optional paired Game-GT evaluation. Set all three to enable RTE/BPE.
GT_FEATURE_INDEX=
GT_FEATURE_CACHE=
REPRO_ROOT=/path/to/Kimodo-SOMA-RP-final-showcase/train

